# Copie para .env.local (dev) e preencha. Em produção, configure nas env vars da Vercel.

# Postgres: local para teste; Neon em produção (com ?sslmode=require)
DATABASE_URL=postgres://usuario:senha@localhost:5432/sdr_fd_test

# URL pública da aplicação (links nos e-mails; https => cookie Secure)
APP_URL=http://localhost:3100
PORT=3100

# E-mail: false = só registra no console, não envia
MAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM_NAME=SDR FD Consultoria

# Primeiro admin (npm run seed) - troca de senha obrigatória no 1º login
SEED_ORG_NAME=FD Consultoria
SEED_ADMIN_NAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# IA (Claude). Modelo padrão: claude-opus-5-5
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Prospecção: com MAIL_REDIRECT_TO preenchido, TODO e-mail de prospecção vai para esse endereço
# (teste), nunca para o lead. Deixe vazio só em produção, com a caixa de prospecção pronta.
MAIL_REDIRECT_TO=
# Caixa de prospecção (domínio separado do principal). Vazio = usa SMTP_*.
PROSPECT_SMTP_HOST=
PROSPECT_SMTP_PORT=587
PROSPECT_SMTP_USER=
PROSPECT_SMTP_PASS=
# Leitura das respostas (IMAP da mesma caixa)
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASS=
# Protege GET /api/cron/inbox (Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=

# Google Maps (Places API New) - captação por busca de texto; cobrança por uso
GOOGLE_PLACES_API_KEY=
