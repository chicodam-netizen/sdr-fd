# Copie para .env.local (dev) e preencha. Em produção, configure nas env vars da Vercel.

# Postgres: local para teste; Neon em produção (com ?sslmode=require)
DATABASE_URL=postgres://usuario:senha@localhost:5432/sdr_fd_test

# URL pública da aplicação (links nos e-mails; https => cookie Secure)
APP_URL=http://localhost:3100
PORT=3100

# E-mail: false = só registra no console, não envia
MAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM_NAME=SDR FD Consultoria

# Primeiro admin (npm run seed) - troca de senha obrigatória no 1º login
SEED_ORG_NAME=FD Consultoria
SEED_ADMIN_NAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
